# MR HASAR — ÖRNEK ENV DOSYASI
# Bu dosyayı `.env` olarak kopyalayıp gerçek değerlerle doldurun.
# .env dosyası ASLA git'e commit edilmemelidir.

# === VERİTABANI ===
DB_HOST=localhost
DB_NAME=mrhasard_dosyatakip
DB_USER=mrhasard_dtuser
DB_PASS=BURAYA_GERCEK_SIFRE

# === JWT ===
# 64+ karakter rastgele bir dize üretin (örn. openssl rand -hex 64)
JWT_SECRET=BURAYA_RASTGELE_64_KARAKTER_GIZLI_ANAHTAR
JWT_EXPIRE=86400
JWT_REFRESH_EXPIRE=2592000

# === CORS ===
# Virgülle ayrılmış izinli origin listesi
# Örn: https://mrhasardanismanlik.com,https://www.mrhasardanismanlik.com
ALLOWED_ORIGINS=https://mrhasardanismanlik.com,https://www.mrhasardanismanlik.com

# === ORTAM ===
# production: hatalar gizli, log dosyasına yazılır
# development: hatalar ekrana gösterilir
APP_ENV=production
ERROR_LOG_PATH=
