# ═══════════════════════════════════════════
# MR HASAR DANIŞMANLIK - Uploads Güvenlik
# Konum: public_html/uploads/.htaccess
#
# ⚠️ Bu dosya sayesinde uploads/ klasöründeki
#    PDF'lere direkt URL ile erişilemez.
#    Sadece API üzerinden (auth kontrolüyle) indirilebilir.
# ═══════════════════════════════════════════

# Tüm direkt erişimi engelle
Require all denied

# PHP çalıştırmayı da engelle (güvenlik)
<FilesMatch "\.php$">
    Require all denied
</FilesMatch>
