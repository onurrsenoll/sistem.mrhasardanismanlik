{
  "name": "mr-hasar-frontend-build",
  "version": "2.0.0",
  "private": true,
  "description": "MR HASAR Danışmanlık — JSX → JS önceden derleyici (cPanel deploy için)",
  "scripts": {
    "build": "babel js --out-dir js/dist --presets=@babel/preset-react --no-babelrc --copy-files",
    "build:clean": "rm -rf js/dist && npm run build"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.0",
    "@babel/core": "^7.24.0",
    "@babel/preset-react": "^7.24.0"
  }
}
